# Copy to `.env.local` for local overrides. Values starting with VITE_ are
# bundled into the public JavaScript: never put secrets here.

# URL of the FastAPI backend. Defaults to http://localhost:8000 during `npm run dev`.
# On Vercel, set this to your deployed backend, e.g. https://your-api.onrender.com
VITE_API_URL=http://localhost:8000
