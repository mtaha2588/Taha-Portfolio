# Copy this file to `.env` and fill in real values. Never commit `.env`.

APP_ENV=development
# Comma-separated list of frontend origins allowed to call the API (CORS).
# Production example: https://your-portfolio.vercel.app
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Optional: also allow Vercel preview URLs (regular expression).
# CORS_ORIGIN_REGEX=^https://your-project-[a-z0-9-]+\.vercel\.app$
CORS_ORIGIN_REGEX=
# Set to true when deployed behind a proxy (Render, Railway) so rate limiting sees the real visitor IP.
TRUST_PROXY=false

# SQLite for local development. For production, use PostgreSQL, e.g.
# postgresql://user:password@host:5432/dbname   (postgres:// and postgresql:// both work)
DATABASE_URL=sqlite:///./portfolio.db

# Protects GET /api/contact/messages. Leave empty to disable that endpoint entirely.
ADMIN_API_KEY=

# ---- Optional: email notification for new contact messages ----
# Leave SMTP_HOST empty and the API still works (messages are saved to the database only).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
CONTACT_NOTIFY_EMAIL=

# ---- Optional: connect the project demos to your REAL project services ----
# While empty, each demo runs the built-in implementation in app/demos/<project>/.
# When set, the portfolio forwards demo requests to your deployed service instead,
# e.g. AVALANCHE_SERVICE_URL=https://avalanche-api.onrender.com
AVALANCHE_SERVICE_URL=
AUTOMATION_AGENT_SERVICE_URL=
CAR_SALES_SERVICE_URL=
